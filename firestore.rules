rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default fallback: deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // 1. Users collection and its subcollections nested
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;

      // 2. Private subcollection (progression, story, saves)
      match /private/{document} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        // Cloud saves must be written by the uploadSave callable function so
        // the server computes the secret-bearing checksum with Admin SDK.
        allow write: if isSignedIn() && request.auth.uid == userId && document != 'saves';
      }
    }

    // 3. Leaderboard entries: Publicly readable, server-writable only
    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if false;
    }

    // 4. Server-only internal collections — no client access (admin SDK only)
    match /_sessions/{document} {
      allow read, write: if false;
    }
    match /_rateLimits/{document} {
      allow read, write: if false;
    }

    // 5. Test connection fallback check
    match /test/{document} {
      allow read: if true;
    }
  }
}
