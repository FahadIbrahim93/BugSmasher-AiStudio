rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. User Profiles: Only the authenticated owner can read or write
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. User Private Subcollections (saves, progression, story): Only the authenticated owner can read or write
    match /users/{userId}/private/{document} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 3. Leaderboard entries: Publicly readable, but only the authenticated owner can write their own entry
    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
