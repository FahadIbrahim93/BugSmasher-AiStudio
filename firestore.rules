rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default fallback: deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // 1. Users collection and its subcollections nested
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;

      // 2. Private subcollection (progression, story, saves)
      match /private/{document} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // 3. Leaderboard entries: Publicly readable, but owner-writable
    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // 4. Test connection fallback check
    match /test/{document} {
      allow read: if true;
    }
  }
}

