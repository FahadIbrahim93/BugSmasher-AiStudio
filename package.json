{
  "name": "bugsmasher",
  "private": true,
  "version": "2.5.0",
  "description": "Tactical QA base defense — Brutalist OS vs bio-luminescent bugs",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/fahadibrahim93/bugsmasher-hopetheory.git"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && eslint .",
    "lint:eslint": "eslint .",
    "lint:all": "npm run typecheck && npm run lint:eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "ci": "npm run typecheck && npm run validate:functions && npm run test:coverage && npm run test:emulator && npm run build && (npm run lint:eslint || echo \"ESLint advisory: tracked debt remains (see AGENTS.md)\")",
    "validate:functions": "cd functions && npm ci && npm run build && npm run test:unit",
    "test:emulator": "firebase emulators:exec --only firestore \"cd functions && npm run test:emulator\"",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:functions": "cd functions && npm ci && npm run build && cd .. && firebase deploy --only functions",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:all": "npm run ci && firebase deploy --only hosting,firestore:rules,functions",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{md,json,yml,yaml,css}": "prettier --write"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.4",
    "firebase": "^12.13.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.2.7",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.5",
    "esbuild": "^0.28.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "express": "^5.2.1",
    "fake-indexeddb": "^6.2.5",
    "firebase-tools": "^14.9.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.5"
  }
}
