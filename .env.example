[TEMPLATE]
# BUGSMASHER - Local environment overrides
# Copy to .env (gitignored). Firebase config lives in firebase-applet-config.json.

# --- Gemini / Google AI Studio ---
# Optional: Google AI Studio / Gemini image generation
# GEMINI_API_KEY=your_gemini_api_key_here

# --- Vite / Dev Server ---
# Optional: disable Vite HMR in agent/automation environments
# DISABLE_HMR=true

# --- Analytics (P3-01 / P6-A) ---
# Analytics provider: console | posthog | mixpanel | none
#   - console: logs events to browser devtools
#   - posthog: sends to PostHog (requires VITE_POSTHOG_API_KEY)
#   - mixpanel: not yet implemented - falls back to console
# VITE_ANALYTICS_PROVIDER=console

# PostHog project API key (required when VITE_ANALYTICS_PROVIDER=posthog)
# VITE_POSTHOG_API_KEY=phc_your_project_api_key

# PostHog instance host (default: https://us.i.posthog.com)
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# --- Rewarded Ads (P3-05) ---
# Set to true to enable rewarded video ads (continue-run + resource boost)
# When disabled, ad buttons are hidden from the UI
# VITE_ADS_ENABLED=true

# --- Monetization / Supporter Packs (P3-04) ---
# Set to true to enable demo purchase mode (simulated payment flow)
# VITE_ENABLE_DEMO_PURCHASE=true

# --- Legacy (unused - Supabase removed). Do not set:
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
