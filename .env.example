# Copy this to .env (never commit .env or firebase-applet-config.json)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_DATABASE_ID=  # optional, if using named db

# Server only (for functions/cloud - NEVER expose to client bundle)
CHECKSUM_SALT=your_super_secret_server_only_salt_here

