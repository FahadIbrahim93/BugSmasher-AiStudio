{
  "name": "bugsmasher-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts test/saveSchema.test.ts",
    "test:emulator": "npm run build && vitest run --config vitest.config.ts test/rules.test.ts test/callables.test.ts",
    "test:emulator:all": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase-functions-test": "^3.4.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.5"
  }
}
